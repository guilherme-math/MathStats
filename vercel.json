{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "regions": ["iad1"],
  "redirects": [
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/register.html", "destination": "/register", "permanent": true },
    { "source": "/recover.html", "destination": "/recover", "permanent": true },
    { "source": "/mfa.html", "destination": "/mfa", "permanent": true },
    {
      "source": "/politica-de-privacidade.html",
      "destination": "/politica-de-privacidade",
      "permanent": true
    },
    { "source": "/termos-de-uso.html", "destination": "/termos-de-uso", "permanent": true },
    { "source": "/dashboard.html", "destination": "/dashboard", "permanent": true },
    { "source": "/conta.html", "destination": "/conta", "permanent": true }
  ],
  "functions": {
    "src/server.ts": {
      "includeFiles": "protected/**"
    }
  }
}