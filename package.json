{
  "name": "mathstats",
  "version": "1.0.0",
  "description": "Plataforma educacional de matemática e estatística com dados de futebol.",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "axios": "^1.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "speakeasy": "^2.0.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "google-gax": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/selfsigned": "^2.0.4",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
